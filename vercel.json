{
  "functions": {
    "api/generate-pdf.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/member",
      "missing": [{ "type": "host", "value": "member.nestara.co.ke" }],
      "destination": "https://member.nestara.co.ke",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "member.nestara.co.ke" }],
      "destination": "/index.html"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
